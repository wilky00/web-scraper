# AI Assist endpoint configuration — non-secret options only.
# The LiteLLM master key lives in .env as AI_API_KEY.
# The OpenRouter API key lives in .env as OPENROUTER_API_KEY (passed to LiteLLM).

# provider: litellm | openrouter | anthropic | openai
# Use 'litellm' when running the LiteLLM proxy (recommended — see docker-compose.yml).
provider: litellm
base_url: "http://litellm:4000/v1"
model: "anthropic/claude-3-5-sonnet"
max_tokens: 4096
temperature: 0.3

# Explicit model allowlist — must match model_name entries in config/litellm_config.yaml.
# Leave empty ([]) to fetch the list from LiteLLM's /models endpoint automatically.
models:
  - "anthropic/claude-3-5-sonnet"
  - "anthropic/claude-3-haiku"
  - "openai/gpt-4o"

# Skills available to the AI assistant
skills:
  criteria_creation: true
  criteria_update: true
  criteria_validation: true
