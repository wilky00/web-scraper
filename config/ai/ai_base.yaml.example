# AI Assist endpoint configuration — non-secret options only.
# The API key must live in .env as AI_API_KEY.

# provider: openrouter | anthropic | openai | litellm
provider: openrouter
base_url: "https://openrouter.ai/api/v1"
model: "anthropic/claude-3-5-sonnet"
max_tokens: 4096
temperature: 0.3

# Explicit model allowlist — only these models appear in the UI dropdown.
# When set, the provider's /models endpoint is never called.
# Leave empty ([]) to fetch all models from the provider automatically.
models:
  - "anthropic/claude-3-5-sonnet"
  - "anthropic/claude-3-haiku"
  - "openai/gpt-4o"

# Skills available to the AI assistant
skills:
  criteria_creation: true
  criteria_update: true
  criteria_validation: true
