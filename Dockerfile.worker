# ABOUTME: Worker container — same base as app but adds Playwright + Chromium for web crawling.
# ABOUTME: Playwright must ONLY be used in this container, never imported in app/.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.10 /uv /uvx /usr/local/bin/

WORKDIR /app

# Install core deps + worker extras (playwright)
COPY pyproject.toml uv.lock* ./
RUN uv pip install --system --no-cache ".[worker]"

# Install Playwright browsers + system dependencies (requires root)
RUN playwright install --with-deps chromium

COPY app/ ./app/

RUN useradd --system --create-home --shell /bin/bash appuser \
    && chown -R appuser:appuser /app

USER appuser

CMD ["rq", "worker", "--with-scheduler", "default"]
