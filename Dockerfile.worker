# ABOUTME: Worker container — Python 3.12, Playwright + Chromium, RQ worker process.
# ABOUTME: Browser automation (PageFetcher, screenshots) runs here via RQ background jobs.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.10 /uv /uvx /usr/local/bin/

WORKDIR /app

# Install all dependencies (playwright is a base dep)
COPY pyproject.toml uv.lock* ./
RUN uv pip install --system --no-cache .

# Install Playwright browsers + system dependencies (requires root)
RUN playwright install --with-deps chromium

COPY app/ ./app/

RUN useradd --system --create-home --shell /bin/bash appuser \
    && chown -R appuser:appuser /app

USER appuser

CMD ["rq", "worker", "--with-scheduler", "default"]
