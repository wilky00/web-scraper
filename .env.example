# ============================================================
# Web Scraper — Required Environment Variables
# Copy to .env and fill in all values before running.
# NEVER commit .env to git.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://scraper:changeme@db:5432/scraper
DB_PASSWORD=changeme

# --- Redis ---
REDIS_URL=redis://:changeme@redis:6379/0
REDIS_PASSWORD=changeme

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=changeme-replace-with-openssl-rand-hex-32
API_TOKEN_SECRET=changeme-replace-with-openssl-rand-hex-32

# --- Storage (S3 / MinIO) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=changeme
S3_BUCKET_NAME=web-scraper

# --- Operator seed account (used on first boot to create the initial user) ---
SEED_OPERATOR_EMAIL=admin@example.com
SEED_OPERATOR_PASSWORD=changeme

# --- Connectors (Phase 3) ---
GOOGLE_PLACES_API_KEY=
BRAVE_API_KEY=

# --- AI Assist (Phase 9) ---
AI_API_KEY=

# --- Authentik SSO (Phase 10) ---
# Set features.sso_enabled: true in config/app.yml to activate the SSO button.
# AUTHENTIK_BASE_URL: base URL of your Authentik instance, e.g. https://auth.saltrun.net
# AUTHENTIK_APP_SLUG: the Application slug set in Authentik (default: web-scraper)
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_BASE_URL=
AUTHENTIK_APP_SLUG=web-scraper
